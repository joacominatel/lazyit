    "dev:up": "bun scripts/dev-setup.ts --up"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.282",
    "@types/bun": "^1.4.2",
    "shadcn": "^4.21.0",
    "turbo": "^2.11.4"
  },
  "peerDependencies": {
    "typescript": "^6"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  }
}
