# Base URL of the lazyit API (NestJS). Read by lib/api/client.ts.
# Copy this file to .env and adjust as needed: cp .env.example .env
NEXT_PUBLIC_API_URL=http://localhost:3001

# Instance-wide display time zone for all dates/times (issue #548, read by i18n/config.ts).
# lazyit is single-org self-hosted with no per-user time zone in v1, so one IANA zone applies to
# the whole instance. The NEXT_PUBLIC_ prefix lets the SAME value reach both the server and the
# client so timestamps agree (no hydration mismatch). Defaults to UTC when unset.
# Example: America/Argentina/Buenos_Aires
NEXT_PUBLIC_DEFAULT_TIME_ZONE=UTC

# ─── Auth.js v5 (next-auth) — see ADR-0039 ────────────────────────────────────
#
# Generate AUTH_SECRET with:  openssl rand -base64 32
AUTH_SECRET=CHANGE_ME

# Dev runs with local accounts (`bun run dev:fresh` sets AUTH_MODE=local here), so leave these unset.
# OIDC is bring-your-own-IdP (ADR-0102): to sign in through your IdP, set all three to the client you
# registered there (redirect URI: <AUTH_URL>/api/auth/callback/oidc). Setting AUTH_ISSUER enables the
# OIDC sign-in.
# AUTH_ISSUER=https://idp.example.com
# AUTH_CLIENT_ID=CHANGE_ME
# AUTH_CLIENT_SECRET=CHANGE_ME

# The public URL Next.js is accessible at. Auth.js v5 reads AUTH_URL (NOT the v4-era NEXTAUTH_URL)
# to build the OIDC callback URL; it must match the redirect URI registered in your IdP.
AUTH_URL=http://localhost:3000

# Trust the host/proxy headers when computing the callback URL. Required behind Caddy / any reverse
# proxy (prod), and avoids the 0.0.0.0:3000 callback failure in dev. Keep this true.
AUTH_TRUST_HOST=true

# AUTH_INTERNAL_ISSUER — optional Docker split-DNS workaround (read by apps/web/auth.ts). Set ONLY
# when the web container cannot resolve the external AUTH_ISSUER host from inside the Docker network.
# When set, server-side OIDC calls (discovery / token / userinfo) are rewritten to this internal
# origin (with X-Forwarded-*); the browser-facing authorization redirect still uses AUTH_ISSUER.
# Unset in plain local dev. Example: an IdP container on the same Docker network.
# AUTH_INTERNAL_ISSUER=http://idp.internal:8080

# ─── Server-side networking ───────────────────────────────────────────────────
#
# INTERNAL_API_URL — Docker-internal URL for the API, read SERVER-SIDE ONLY (lib/api/client.ts:36,
# proxy.ts:33). On the server, Node's fetch (undici) requires an absolute URL; this lets the web
# container reach the API via the Docker network (e.g. http://api:3001) instead of going through the
# public Caddy proxy. Falls back to NEXT_PUBLIC_API_URL → http://localhost:3001 when unset (fine for
# local dev where web and api run in the same process). compose.yaml sets this automatically in prod.
# NOT prefixed NEXT_PUBLIC_ — never baked into the client bundle (ADR-0026).
# INTERNAL_API_URL=http://api:3001

