# --- @lazyit/api environment ---
# Copy to `apps/api/.env` and fill in. Bun auto-loads .env for the app; the Prisma CLI
# reads DATABASE_URL via prisma.config.ts (which imports dotenv/config).

# Postgres connection used by Prisma. Credentials/db must match the root .env
# (POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB) and the compose service on :5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lazyit?schema=public"

# Port the NestJS API listens on.
PORT=3001

# Express `trust proxy` hop count (SEC-010). Controls how `req.ip` (which keys the /config/setup
# rate-limiter + the first-run audit IP) is derived from X-Forwarded-For. Leave UNSET in dev: with no
# reverse proxy, `req.ip` is the socket address and a forged X-Forwarded-For is ignored. Behind a
# reverse proxy set it to the number of proxy hops (Caddy = 1). NEVER set "true" on a public origin
# where the client can reach the API directly (it would trust a spoofed XFF).
# TRUST_PROXY=1

# Log format (ADR-0031): unset / any non-"production" value => pretty, human-readable dev logs;
# "production" => structured JSON. The prod container sets NODE_ENV=production; leave it unset locally.
# NODE_ENV=production

# Allowed CORS origin — the web app's URL. Used by app.enableCors() in main.ts.
WEB_ORIGIN="http://localhost:3000"

# LAN host-agnostic mode (issue #1035) — set to `true` to reach the app at ANY Host (IP/hostname)
# over plain HTTP on a trusted LAN: CORS reflects the request Origin and WEB_ORIGIN is left unset.
# Requires AUTH_MODE=local (OIDC bakes a fixed external domain). Default OFF; never enable on an
# internet-facing deploy.
# AUTH_TRUST_HOST=true

# Max size (MB) for the article import endpoint (POST /articles/import). Default 5 if unset.
MAX_IMPORT_SIZE_MB=5

# --- Async workers / BullMQ (ADR-0053) ---
# Redis-protocol URL for the self-hosted Valkey (Redis-compatible) engine that backs the job queue.
# The compose service `valkey` listens on :6379; compose.override.yaml publishes 127.0.0.1:6379 for
# native `bun run dev`. Powers the async article import (POST /articles/import → 202 + jobId, polled
# at GET /articles/import/:jobId). Defaults to redis://127.0.0.1:6379 if unset.
# REQUIRED in containers/prod — set it to the broker host (e.g. redis://valkey:6379); the localhost
# default points at the API container itself, where no Valkey runs. The API logs the RESOLVED URL
# (password redacted) at boot, bounds reconnection (no infinite ECONNREFUSED loop, no log flood), and
# fails enqueues fast with a 503 when the broker is unreachable rather than hanging the import (#257).
REDIS_URL="redis://127.0.0.1:6379"

# Node heap cap (MB) for the SANDBOXED .docx import worker child (SEC-002). A decompression bomb
# expands past this and OOMs the isolated child, never the API. Default 256 if unset/invalid.
# IMPORT_CHILD_HEAP_MB=256

# --- File attachments (ADR-0082) ---
# Root of the attachment blob store (asset documents + KB inline images). Blobs live as
# `<dir>/<sha[0:2]>/<sha256>` plus an in-flight `<dir>/tmp/`. Default: `<cwd>/attachments` —
# `apps/api/attachments` in native dev (gitignored) and `/app/attachments` in the container, where
# the `attachments_data` volume mounts. ⚠ NOT covered by any backup yet (deferred to v1.1 —
# ADR-0082; see docs/05-runbooks/backups.md).
# ATTACHMENTS_DIR=
# Total attachment storage budget (MB) — the single-host quota (ADR-0082 §7). An upload past it is
# rejected with a clean 507 "storage full". Default 5120 (5 GB) if unset/invalid.
# ATTACHMENTS_MAX_TOTAL_MB=5120
# Node heap cap (MB) for the SANDBOXED sharp image re-encode child (EXIF strip / polyglot
# neutralization) — the IMPORT_CHILD_HEAP_MB pattern, same OPS-5 mem_limit invariant. Default 256.
# ATTACHMENT_CHILD_HEAP_MB=256

# --- Applications Workflow Engine secrets (ADR-0054, epic #248) ---
# AES-256-GCM master key for the engine's OWN encrypted credential store (WorkflowSecret) — the
# per-app connector credentials (Jira tokens, OAuth secrets, webhook signing keys). This is a SECRET;
# it is NEVER logged. Must decode to EXACTLY 32 bytes — 64 hex chars (preferred), base64 of 32 bytes,
# or a 32-char raw string. Generate one with: openssl rand -hex 32
# REQUIRED: the engine (WorkflowEngineModule) is wired into the app, so the API FAILS LOUD AT BOOT if
# this is missing or the wrong length (a half-configured secret store is worse than an absent one). The
# Jest suite supplies a throwaway test key (test/jest.env-setup.ts). Losing this key = losing every stored
# connector credential (recoverable only by re-entering them — see docs/05-runbooks/backups.md). It is
# a SEPARATE key axis from the Settings store: one key per subsystem.
WORKFLOW_SECRET_KEY=

# --- Instance SMTP / outbound email (ADR-0079, issue #615) ---
# AES-256-GCM master key for the instance SMTP PASSWORD at rest (Settings → Instance → SMTP). The SMTP
# password is a SERVER-MANAGED machine credential (the server must read it to authenticate to the relay —
# the explicit inverse of the zero-knowledge Secret Manager). This is a SECRET; it is NEVER logged. Must
# decode to EXACTLY 32 bytes — 64 hex chars (preferred), base64 of 32 bytes, or a 32-char raw string.
# Generate one with: openssl rand -hex 32
# OPTIONAL (differs from WORKFLOW_SECRET_KEY): the app boots fine WITHOUT it and outbound email is simply
# unavailable; it is required ONLY when an admin saves an SMTP password (a clean 409 explains this). It is
# its OWN key axis, SEPARATE from WORKFLOW_SECRET_KEY (one key per subsystem). Losing this key = losing the
# stored SMTP password (re-enter it in the UI — see docs/05-runbooks/backups.md). The Jest suite supplies
# its own throwaway key per-test.
SMTP_SECRET_KEY=

# --- On-prem AD/LDAP directory source (ADR-0091, issue #839) ---
# AES-256-GCM master key for the read-only LDAP BIND password at rest (Settings → Instance → Directory).
# The bind password is a SERVER-MANAGED machine credential (the server must decrypt it to bind against AD —
# the explicit inverse of the zero-knowledge Secret Manager). This is a SECRET; it is NEVER logged. Must
# decode to EXACTLY 32 bytes — 64 hex chars (preferred), base64 of 32 bytes, or a 32-char raw string.
# Generate one with: openssl rand -hex 32
# OPTIONAL (like SMTP_SECRET_KEY, unlike WORKFLOW_SECRET_KEY): the app boots fine WITHOUT it and directory
# sync is simply unavailable; it is required ONLY when an admin saves an LDAP bind password (a clean 409
# explains this). Its OWN key axis, SEPARATE from the others (one key per subsystem). Losing this key =
# losing the stored bind password (re-enter it in the UI). The Jest suite supplies its own throwaway key.
DIRECTORY_SECRET_KEY=

# Optional tuning: how often the directory-sync sweeper runs the read-only reconcile (ms). Default 1h.
# DIRECTORY_SYNC_INTERVAL_MS=3600000

# Meilisearch (ADR-0035). MEILI_HOST = the engine URL; MEILI_MASTER_KEY must match the root .env.
# The compose service `meilisearch` listens on :7700. Search degrades gracefully when Meili is
# unreachable (index sync is fire-and-forget). If MEILI_HOST is unset, search wiring is disabled.
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY=
# Drift-reconcile sweeper (ADR-0035 amendment 2026-06-14, issue #383): how often (ms) to rebuild every
# index from the DB so a dropped fire-and-forget sync self-heals without a manual `reindex:all`. Default
# hourly (3600000). A non-numeric / non-positive value falls back to the default. No-op when MEILI_HOST
# is unset (search disabled) or under NODE_ENV=test.
SEARCH_RECONCILE_INTERVAL_MS=3600000

# OIDC / Auth (ADR-0037, ADR-0038, ADR-0086). The guard lives at apps/api/src/auth/jwt-auth.guard.ts.
# AUTH_MODE is a THREE-state, EXPLICIT-REQUIRED enum — one of: shim | local | oidc. There is NO implicit
# default anymore (ADR-0086 §2): leaving it UNSET is a hard boot failure. (It used to default to OIDC when
# unset; with the third mode that silent default would flip an existing OIDC deploy to `local` → outage,
# so unset now fails loud. UPGRADE: an existing OIDC deploy MUST set `AUTH_MODE=oidc` before upgrading.)
#   - shim  — dev/tests only: the X-User-Id header (direct API access via curl/Swagger). NOT wired into the
#             web UI. REFUSED when NODE_ENV=production (the header is forgeable).
#   - local — first-party auth: lazyit owns username/email + password, no external IdP (ADR-0086). REQUIRES
#             SESSION_SIGNING_SECRET below. Allowed in production.
#   - oidc  — generic OIDC against your own IdP (BYOI, ADR-0102). REQUIRES OIDC_ISSUER + OIDC_JWKS_URI below.
#
# DEV QUICKSTART: run `bun run dev:fresh` from the repo root — it bootstraps Zitadel and sets AUTH_MODE=oidc
# + OIDC_ISSUER + OIDC_JWKS_URI below automatically. Keep AUTH_MODE=shim only if you want the API-direct
# (no browser) shortcut without Zitadel.
AUTH_MODE=shim
# SESSION_SIGNING_SECRET — REQUIRED in local mode (AUTH_MODE=local): the persistent HMAC key the API signs
# its first-party session token with (HS256, ADR-0086 §4). Must be at least 32 chars — generate with:
# openssl rand -hex 32. It is DISTINCT from the web's AUTH_SECRET (Auth.js cookie key). Lower DR severity
# than WORKFLOW_SECRET_KEY: rotating it only forces re-login (no data loss). Do NOT make
# it per-boot-random (that would silently invalidate every session on each restart). Leave UNSET for
# shim/oidc modes. The Jest suite supplies its own throwaway value.
# SESSION_SIGNING_SECRET=
# Seeded ADMIN for the X-User-Id shim — DEV CONVENIENCE, OPT-IN (#333). `bunx prisma db seed` creates
# an ADMIN with THIS email ONLY when it is set; uncomment for a ready-to-use admin in shim mode. LEAVE
# UNSET in prod / zero-touch: a pre-seeded admin trips the /setup wizard's "already configured" gate
# and forces the first real OIDC login to VIEWER. With it unset, the /setup wizard (or the first OIDC
# login → ADMIN) owns the first administrator (ADR-0043). Category + role-permission seeds run regardless.
# SEED_ADMIN_EMAIL=admin@lazyit.local
# SEED_ADMIN_PASSWORD — local-auth (AUTH_MODE=local) dev/test convenience, OPT-IN and paired with
# SEED_ADMIN_EMAIL above (there is no seeded admin to attach a password to otherwise). Set it to log
# in to a fresh local dev/test instance without a manual `bun run reset-admin-password` step. GATED
# to non-production (#333): when NODE_ENV=production the seed IGNORES this var (with a warning) no
# matter what it is set to — a passworded default must never reach a real deploy. The only ways to
# get a first local-auth admin password in production are the /setup wizard or the
# `reset-admin-password` recovery CLI (ADR-0086 §5).
# SEED_ADMIN_PASSWORD=
# OIDC issuer URL of your own IdP (Entra ID, Okta, Keycloak, Authentik, ...) — generic OIDC, no vendor
# SDK: tokens are verified through the issuer's JWKS (ADR-0102 §2). The web's AUTH_ISSUER /
# AUTH_CLIENT_ID / AUTH_CLIENT_SECRET (apps/web/.env) point at the same IdP. See auth-bootstrap.md.
OIDC_ISSUER=
# OIDC_CLIENT_ID — optional. If set, the guard validates the token `aud` against it; if unset,
# audience validation is skipped (some IdPs put a resource audience on access tokens, not the client id).
OIDC_CLIENT_ID=
# OIDC_JWKS_URI — REQUIRED in OIDC mode (AUTH_MODE=oidc; boot fails without it). The JWKS URL the guard
# fetches signing keys from — your IdP's `jwks_uri` from its discovery document. When it is an internal
# origin the issuer host doesn't resolve to (Docker split-DNS, e.g. http://idp.internal:8080/oauth/v2/keys),
# discovery + userinfo are also rewritten to that origin (with X-Forwarded-* derived from OIDC_ISSUER).
# See auth-bootstrap.md.
# OIDC_JWKS_URI=
#
# NOTE: the API does NOT read an OIDC client secret. The client secret is the WEB's responsibility
# (apps/web/.env → AUTH_CLIENT_SECRET, used by Auth.js for the authorization-code exchange).

# IDENTITY_PROVIDER_TYPE is no longer needed: AUTH_MODE=oidc always uses generic OIDC (ADR-0102 §4).
# A leftover `zitadel` value is tolerated (one boot warning) and any ZITADEL_MGMT_* is ignored. The API
# REFUSES to start in OIDC mode with an active ZITADEL_MASTERKEY, or an OIDC_ISSUER / OIDC_JWKS_URI at
# the bundled zitadel:8080 — see docs/05-runbooks/migrate-off-bundled-zitadel.md.

# --- First-run setup wizard CSRF (ADR-0043 Phase 3) ---
# Signing key for the stateless CSRF tokens that gate POST /config/setup (the public first-run
# bootstrap). OPTIONAL: when unset, the API derives a random per-boot key — fine for a single-instance
# first-run (the wizard completes within one server lifetime). Set this only if you run MULTIPLE API
# replicas serving the wizard, so a token issued by one replica verifies on another. Not a
# confidentiality secret (these are anti-CSRF nonces), but treat it like one.
# SETUP_CSRF_SECRET=
